+int GUIAction::RunDirect(const std::string& function,
+			 const std::string& arg)
+{
+  LOGINFO("RunDirect: function='%s', arg='%s', registered_actions=%lu\n",
+      function.c_str(), arg.c_str(),
+      (unsigned long)mf.size());
+
+  /*
+   * Must not pass nullptr:
+   * the GUIAction constructor returns early on nullptr, before the mf
+   * action table is initialized. Use an empty element node so that the
+   * constructor completes the action table initialization.
+   */
+  rapidxml::xml_document<> doc;
+  rapidxml::xml_node<>* node =
+      doc.allocate_node(rapidxml::node_element);
+
+  GUIAction action(node);
+
+  Action direct_action;
+  direct_action.mFunction = function;
+  direct_action.mArg = arg;
+
+  return action.doAction(direct_action);
+}
